{
  "openapi": "3.1.0",
  "info": {
    "title": "DrugsEngine Universal API",
    "description": "Production OpenAPI 3.1 contract for the DrugsEngine pharmaceutical search, vector analog discovery, pharmacy locator, and observability ecosystem.",
    "version": "1.0.0",
    "contact": {
      "name": "DrugsEngine Engineering Team",
      "url": "https://github.com/Asm-o-Dan/DrugEngine"
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Next.js App Gateway & Mock Handlers"
    },
    {
      "url": "http://localhost:8080/api/v1",
      "description": "Local .NET 8 Web API Gateway"
    },
    {
      "url": "https://api.drugsengine.internal/api/v1",
      "description": "Production Microservice Gateway"
    }
  ],
  "paths": {
    "/search/drugs": {
      "get": {
        "summary": "Universal Smart Drug Search",
        "description": "Executes exact lexical search, Qdrant 768-dim LaBSE vector semantic search, or hybrid score fusion.",
        "operationId": "searchDrugs",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query text",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "ибупрофен"
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "exact",
                "semantic",
                "hybrid"
              ],
              "default": "hybrid"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "manufacturer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "countryCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "inStockOnly",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "minPrice",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "maxPrice",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "scoreThreshold",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "default": 0.65
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "name_asc",
                "similarity_desc"
              ],
              "default": "relevance"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/SearchDrugsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/search/suggestions": {
      "get": {
        "summary": "Search Suggestions",
        "operationId": "getSearchSuggestions",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 6
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Suggestions list",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/SearchSuggestionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/drugs/{id}": {
      "get": {
        "summary": "Get Drug Details",
        "operationId": "getDrugDetails",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Drug details",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/DrugDetailsDto"
                }
              }
            }
          },
          "404": {
            "description": "Drug not found",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/drugs/{id}/analogs": {
      "get": {
        "summary": "Find Qdrant AI Vector Analogs",
        "operationId": "getDrugAnalogs",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "threshold",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "default": 0.7
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 6
            }
          },
          {
            "name": "inStockOnly",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vector analogs",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/DrugAnalogsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Source drug not found",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/pharmacies": {
      "get": {
        "summary": "Find Pharmacies with Stock",
        "operationId": "getPharmacies",
        "parameters": [
          {
            "name": "drugId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "default": 55.7558
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "default": 37.6173
            }
          },
          {
            "name": "radiusKm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "default": 10.0
            }
          },
          {
            "name": "network",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "inStockOnly",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "isOpenNow",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pharmacy list",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/PharmacyListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/pharmacies/{pharmacyId}": {
      "get": {
        "summary": "Get Pharmacy Profile",
        "operationId": "getPharmacyDetails",
        "parameters": [
          {
            "name": "pharmacyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pharmacy profile",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/PharmacyDto"
                }
              }
            }
          },
          "404": {
            "description": "Pharmacy not found",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/pharmacies/{pharmacyId}/reserve": {
      "post": {
        "summary": "Reserve Medication Hold",
        "operationId": "createReservation",
        "parameters": [
          {
            "name": "pharmacyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "": "#/components/schemas/CreateReservationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reservation confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/ReservationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Reservation failed",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/pharmacies/{pharmacyId}/directions": {
      "get": {
        "summary": "Get Directions",
        "operationId": "getDirections",
        "parameters": [
          {
            "name": "pharmacyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromLat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "fromLng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "driving",
                "walking",
                "transit"
              ],
              "default": "driving"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Directions",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/DirectionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/telemetry/health": {
      "get": {
        "summary": "System Health Diagnostics",
        "operationId": "getSystemHealth",
        "responses": {
          "200": {
            "description": "Subsystem health",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/SystemHealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Degraded/Down health",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/SystemHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/telemetry/metrics": {
      "get": {
        "summary": "Live Metrics Snapshot",
        "operationId": "getSystemMetrics",
        "responses": {
          "200": {
            "description": "Metrics",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/SystemMetricsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/telemetry/metrics/history": {
      "get": {
        "summary": "Metrics History Timeseries",
        "operationId": "getMetricsHistory",
        "parameters": [
          {
            "name": "metric",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "latency"
          },
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "15m",
                "1h",
                "6h",
                "24h"
              ],
              "default": "1h"
            }
          },
          {
            "name": "step",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1m"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Timeseries history",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/MetricsHistoryResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiErrorResponse": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "timestamp",
          "traceId"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "traceId": {
            "type": "string"
          },
          "validationErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "CountryDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "code"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Money": {
        "type": "object",
        "required": [
          "minPrice",
          "currency"
        ],
        "properties": {
          "minPrice": {
            "type": "number"
          },
          "maxPrice": {
            "type": "number"
          },
          "averagePrice": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB",
              "USD",
              "EUR"
            ]
          }
        }
      },
      "SearchDrugItem": {
        "type": "object",
        "required": [
          "id",
          "name",
          "manufacturer",
          "country",
          "category",
          "activeIngredient",
          "dosage",
          "releaseForm",
          "description",
          "score",
          "matchType",
          "pricing",
          "stockSummary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "country": {
            "": "#/components/schemas/CountryDto"
          },
          "category": {
            "type": "string"
          },
          "activeIngredient": {
            "type": "string"
          },
          "dosage": {
            "type": "string"
          },
          "releaseForm": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "matchType": {
            "type": "string",
            "enum": [
              "EXACT",
              "SEMANTIC",
              "HYBRID"
            ]
          },
          "highlightedName": {
            "type": "string"
          },
          "pricing": {
            "": "#/components/schemas/Money"
          },
          "stockSummary": {
            "type": "object",
            "required": [
              "inStock",
              "totalPharmacies",
              "totalQuantity"
            ],
            "properties": {
              "inStock": {
                "type": "boolean"
              },
              "totalPharmacies": {
                "type": "integer"
              },
              "totalQuantity": {
                "type": "integer"
              }
            }
          }
        }
      },
      "SearchDrugsResponse": {
        "type": "object",
        "required": [
          "query",
          "mode",
          "total",
          "page",
          "limit",
          "totalPages",
          "executionTimeMs",
          "filtersApplied",
          "items",
          "facets"
        ],
        "properties": {
          "query": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "exact",
              "semantic",
              "hybrid"
            ]
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "executionTimeMs": {
            "type": "number"
          },
          "filtersApplied": {
            "type": "object"
          },
          "items": {
            "type": "array",
            "items": {
              "": "#/components/schemas/SearchDrugItem"
            }
          },
          "facets": {
            "type": "object",
            "properties": {
              "manufacturers": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "countries": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "SearchSuggestionItem": {
        "type": "object",
        "required": [
          "text",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "text": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "DRUG",
              "ACTIVE_INGREDIENT",
              "SYMPTOM_QUERY",
              "BRAND"
            ]
          },
          "category": {
            "type": "string"
          },
          "minPrice": {
            "type": "number",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "SearchSuggestionsResponse": {
        "type": "object",
        "required": [
          "query",
          "suggestions"
        ],
        "properties": {
          "query": {
            "type": "string"
          },
          "suggestions": {
            "type": "array",
            "items": {
              "": "#/components/schemas/SearchSuggestionItem"
            }
          }
        }
      },
      "DrugDetailsDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "manufacturer",
          "country",
          "category",
          "activeIngredient",
          "dosage",
          "packageSize",
          "releaseForm",
          "isPrescriptionRequired",
          "storageConditions",
          "shelfLifeMonths",
          "indications",
          "contraindications",
          "sideEffects",
          "pharmacologicalAction",
          "fullDescription",
          "pricingSummary",
          "stockSummary",
          "qdrantVectorStatus"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "latinName": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "country": {
            "": "#/components/schemas/CountryDto"
          },
          "category": {
            "type": "string"
          },
          "atcCode": {
            "type": "string"
          },
          "activeIngredient": {
            "type": "string"
          },
          "dosage": {
            "type": "string"
          },
          "packageSize": {
            "type": "string"
          },
          "releaseForm": {
            "type": "string"
          },
          "isPrescriptionRequired": {
            "type": "boolean"
          },
          "storageConditions": {
            "type": "string"
          },
          "shelfLifeMonths": {
            "type": "integer"
          },
          "indications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contraindications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sideEffects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pharmacologicalAction": {
            "type": "string"
          },
          "fullDescription": {
            "type": "string"
          },
          "pricingSummary": {
            "": "#/components/schemas/Money"
          },
          "stockSummary": {
            "type": "object"
          },
          "qdrantVectorStatus": {
            "type": "object"
          }
        }
      },
      "VectorAnalogCard": {
        "type": "object",
        "required": [
          "id",
          "name",
          "manufacturer",
          "country",
          "activeIngredient",
          "dosage",
          "releaseForm",
          "similarity",
          "pricing",
          "stockSummary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "country": {
            "": "#/components/schemas/CountryDto"
          },
          "activeIngredient": {
            "type": "string"
          },
          "dosage": {
            "type": "string"
          },
          "releaseForm": {
            "type": "string"
          },
          "similarity": {
            "type": "object",
            "required": [
              "cosineScore",
              "similarityPercentage",
              "matchCategory",
              "matchReason"
            ],
            "properties": {
              "cosineScore": {
                "type": "number"
              },
              "similarityPercentage": {
                "type": "number"
              },
              "matchCategory": {
                "type": "string",
                "enum": [
                  "DIRECT_GENERIC",
                  "THERAPEUTIC_ANALOG",
                  "ACTIVE_SUBSTANCE_MATCH"
                ]
              },
              "matchReason": {
                "type": "string"
              }
            }
          },
          "pricing": {
            "type": "object",
            "required": [
              "minPrice",
              "currency",
              "priceDelta"
            ],
            "properties": {
              "minPrice": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              },
              "priceDelta": {
                "type": "object"
              }
            }
