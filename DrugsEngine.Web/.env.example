# Источник данных: api — бэкенд DrugsEngine, demo — встроенный демонстрационный каталог.
# Если не задан: api при наличии DRUGSENGINE_API_URL, иначе demo.
DRUGSENGINE_DATA_SOURCE=demo

# Базовый адрес бэкенда (только сервер Next.js, в браузер не попадает).
# DRUGSENGINE_API_URL=http://localhost:5080

# Подпись валюты в ценах.
NEXT_PUBLIC_CURRENCY_LABEL=руб.

# Тайлы карты (по умолчанию — OpenStreetMap; для production с заметной нагрузкой
# используйте свой тайл-сервер или коммерческого провайдера, см. tile usage policy OSM).
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap
